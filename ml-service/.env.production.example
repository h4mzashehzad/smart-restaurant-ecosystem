# =============================================================================
# ML SERVICE — PRODUCTION ENVIRONMENT EXAMPLE
# =============================================================================
# Copy these keys into Coolify → Service → Environment Variables.
# Do NOT expose any public port for this service in Coolify —
# it should only be reachable from within the Docker network.
# =============================================================================

FLASK_ENV=production
FLASK_APP=app.py
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smart_restaurant
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
MODEL_PATH=./models
PORT=5005
# Set to your backend Docker service name so CORS only allows internal calls:
ALLOWED_ORIGIN=http://backend
